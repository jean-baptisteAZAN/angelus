{
  "expo": {
    "name": "Angelus",
    "slug": "angelus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "angelus",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.angelus.ios",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "NZMKNK8FPD"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Angelus utilise la caméra pour scanner le QR code d'un groupe."
        }
      ],
      "expo-notifications",
      "expo-audio",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.angelus.ios.widgets",
          "groupIdentifier": "group.app.angelus.ios",
          "widgets": [
            {
              "name": "TodayWidget",
              "displayName": "Thème du jour",
              "description": "Le thème du jour, le temps qu'il te reste et qui a déjà posté.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57286d2c-5157-4d86-9753-d764efb61741"
      }
    },
    "owner": "jbazan"
  }
}
